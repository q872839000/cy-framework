<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cy.commons</groupId>
        <artifactId>cy-commons</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>cy-common-starter-conversation</artifactId>
    <packaging>jar</packaging>
    <description>智能会话组件 - 提供大模型对话、会话管理、聊天记录管理、智能命名等功能</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ==== 内部组件依赖 ==== -->
        <!-- cy-common-orm 持久化层 -->
        <dependency>
            <groupId>com.cy.commons</groupId>
            <artifactId>cy-common-orm</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cy.commons</groupId>
            <artifactId>cy-common-starter-web</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- cy-common-cache 缓存模块 -->
        <dependency>
            <groupId>com.cy.commons</groupId>
            <artifactId>cy-common-cache</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cy.commons</groupId>
            <artifactId>cy-common-ai</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- cy-common-log（@SysLog 审计/系统日志注解，运行时由宿主应用提供 SysLogAspect） -->
        <dependency>
            <groupId>com.cy.commons</groupId>
            <artifactId>cy-common-log</artifactId>
            <version>${project.parent.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- ==== Spring Boot 依赖 ==== -->
        <!-- Spring Boot Web (用于SSE流式输出) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot WebFlux (用于流式调用OpenAI) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==== 可观测性依赖 ==== -->
        <!-- Micrometer 核心 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- ==== 文档依赖 ==== -->
        <!-- Springdoc OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- ==== 工具依赖 ==== -->
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Commons Lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>
</project>
